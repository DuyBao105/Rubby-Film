# Movie API Provider Configuration
MOVIE_API_BASE_URL=https://phimapi.com
MOVIE_PROVIDER=kkphim
MOVIE_API_TIMEOUT_MS=8000
MOVIE_API_RETRY_COUNT=2

# Site URL for OAuth Callbacks & SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth 2.0 Credentials (Server-side only, do NOT expose with NEXT_PUBLIC_)
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook Login OAuth Credentials (Server-side only, do NOT expose with NEXT_PUBLIC_)
# Obtain from: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=your_facebook_app_id
FACEBOOK_CLIENT_SECRET=your_facebook_app_secret

# Community System (Neon Postgres free tier)
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# Session signing secret (auth)
AUTH_SECRET=change_me_to_a_long_random_string
